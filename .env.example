# ─────────────────────────────────────────────
# Adzuna Jobs API
# ─────────────────────────────────────────────
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ─────────────────────────────────────────────
# Supabase (backend / server-side — never expose to browser)
# ─────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─────────────────────────────────────────────
# Supabase (frontend — safe to expose, prefixed NEXT_PUBLIC_)
# Place these in frontend/.env.local for Next.js to pick them up
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ─────────────────────────────────────────────
# Optional — override Poppler binary path for OCR on Windows
# ─────────────────────────────────────────────
# POPPLER_PATH=C:\Program Files\poppler\bin
# SKIP_OCR=1
